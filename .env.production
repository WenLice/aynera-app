# Read by `expo export`, which inlines EXPO_PUBLIC_* values into the JavaScript bundle.
#
# Committed on purpose: anything prefixed EXPO_PUBLIC_ ships inside the bundle the browser
# downloads, so it holds no secret. Keeping it here means a release built by anyone — or by
# Render — points at the same API instead of falling back to the localhost default in
# src/config/aynera.ts and shipping an app that cannot reach anything.
#
# Temporary hosts while the production domain is set up. The API must also list this site's
# origin under Aynera:Cors:Origins, or the browser will block every request.
EXPO_PUBLIC_AYNERA_API_BASE_URL=https://aynera-api.onrender.com

# Where the consent step's Terms, Privacy and Community Guidelines links resolve. A wrong
# value here is three dead links at the moment a member is asked to agree to something.
EXPO_PUBLIC_AYNERA_WEB_BASE_URL=https://aynera.onrender.com
